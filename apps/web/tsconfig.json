{
  "extends": "@twin/config/tsconfig.react.json",
  "compilerOptions": {
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.setup.ts"],
  // Tests are a Node program: they read fixtures off disk. They are typechecked by
  // `tsconfig.test.json`, which adds Node's types — types the browser bundle must not see,
  // because `@types/node` overrides `setTimeout` and friends with signatures the app's own
  // code is not written against.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/__tests__/**"]
}
