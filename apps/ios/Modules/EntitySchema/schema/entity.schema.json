{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hex Entity",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "anchor": {
      "type": "object",
      "properties": {
        "world": {
          "$ref": "#/$defs/vector"
        },
        "geo": {
          "$ref": "#/$defs/geo"
        }
      },
      "required": ["world"],
      "additionalProperties": false
    },
    "extent": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "z": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "masks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keyframe": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": ["keyframe", "ref"],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attrs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": ["module", "model"],
      "additionalProperties": false
    }
  },
  "required": ["label", "anchor", "extent", "masks", "confidence", "attrs", "source"],
  "additionalProperties": false,
  "$defs": {
    "vector": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "geo": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt": {
          "type": "number"
        }
      },
      "required": ["lat", "lon", "alt"],
      "additionalProperties": false
    },
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  }
}
