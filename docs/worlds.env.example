# API/session manager ONLY. Copy to .env.worlds.local (gitignored), chmod 600.
# Load with uvicorn --env-file. Never include secrets in a VITE_ variable/web build.
# Generate DIFFERENT random API and gateway tokens, >=32 printable ASCII characters.
API_WRITE_TOKEN=
WORLD_GATEWAY_TOKEN=
WORLD_DATA_DIR=data/worlds
WORLD_MODEL_ID=astronex-world

# Existing gateway (no account key needed) OR approved-template provisioning.
# Remote URLs must use HTTPS. Only loopback local gateways may use HTTP.
# WORLD_LOCAL_GATEWAY_URL=http://127.0.0.1:8789
# WORLD_RUNPOD_GATEWAY_URL=https://your-pod-8789.proxy.runpod.net
WORLD_RUNPOD_ALLOW_PROVISION=false
# WORLD_RUNPOD_API_KEY=
# WORLD_RUNPOD_TEMPLATE_ID=
WORLD_RUNPOD_GPU_TYPE=NVIDIA L40S
WORLD_RUNPOD_PORT=8789

# Each nondefault model needs its own approved template/image or gateway.
# JSON profile keys use snake_case. Values below are placeholders, not resources.
# WORLD_MODEL_PROFILES_JSON='{"forge-wm":{"runpod_template_id":"approved-forge-template"},"matrix-game-3":{"local_gateway_url":"http://127.0.0.1:8791"},"sana-wm":{"runpod_template_id":"approved-sana-template"},"helix-world":{"runpod_template_id":"approved-helix-template","runpod_gpu_type":"NVIDIA H100 80GB HBM3"}}'

# Required before paid provisioning: durable absolute ledger and explicit rate cap.
# One API replica; keep this directory across restarts/updates.
# WORLD_DATA_DIR=/var/lib/worlds
# WORLD_DATA_PERSISTENT=true
# WORLD_MAX_WORKER_HOURLY_COST=1.00
WORLD_MAX_MANAGED_WORKERS=1
WORLD_SESSION_LEASE_SECONDS=90
WORLD_WORKER_IDLE_SECONDS=300
WORLD_WORKER_STARTUP_SECONDS=900
WORLD_WORKER_MAX_LIFETIME_SECONDS=3600
WORLD_REAPER_INTERVAL_SECONDS=15
WORLD_LIFECYCLE_ENABLED=true

# Dedicated optional Worlds Modal Sandbox. Separate from existing Earth GPU tasks.
WORLD_MODAL_ALLOW_PROVISION=false
# WORLD_MODAL_GATEWAY_URL=https://existing-worlds-gateway.example
# WORLD_MODAL_TOKEN_ID=
# WORLD_MODAL_TOKEN_SECRET=
# WORLD_MODAL_APP_NAME=hexapod-worlds
# WORLD_MODAL_IMAGE=registry.example/worlds-astronex@sha256:tested-image-digest
# WORLD_MODAL_GPU_TYPE=L40S
# WORLD_MODAL_HOURLY_COST=1.00  # Operator estimate, not provider-reported billing.

# Optional Lambda Cloud provisioning; approved image/bootstrap and HTTPS required.
WORLD_LAMBDA_ALLOW_PROVISION=false
# WORLD_LAMBDA_GATEWAY_URL=https://existing-worlds-gateway.example
# WORLD_LAMBDA_API_KEY=
# WORLD_LAMBDA_REGION=
# WORLD_LAMBDA_INSTANCE_TYPE=gpu_1x_a100_sxm4
# WORLD_LAMBDA_SSH_KEY_NAMES='["operator-key"]'
# WORLD_LAMBDA_IMAGE_ID=
# WORLD_LAMBDA_BOOTSTRAP_FILE=/private/reviewed-worlds-bootstrap.sh
# WORLD_LAMBDA_GATEWAY_TEMPLATE=https://{instance_id}.your-worlds-domain.example
# Bootstrap placeholders: {{WORLD_GATEWAY_TOKEN_BASE64}} and {{WORLD_MODEL_ID}}.

# Optional OpenAI-compatible text service (chat completions, JSON object responses).
# WORLDS_LLM_BASE_URL=https://your-service.example/v1
# WORLDS_LLM_MODEL=your-selected-model
# WORLDS_LLM_API_KEY=

# Optional multimodal chat service: scene interpretation, director, character
# analysis/evaluation and replay highlights. Features require per-workflow consent.
# WORLDS_VISION_BASE_URL=https://your-service.example/v1
# WORLDS_VISION_MODEL=your-vision-model
# WORLDS_VISION_API_KEY=

# Optional image service: image generations AND multipart reference-image edits.
# Must return base64 image data; remote output URLs are not fetched.
# WORLDS_IMAGE_BASE_URL=https://your-service.example/v1
# WORLDS_IMAGE_MODEL=your-image-model
# WORLDS_IMAGE_API_KEY=

# Separate reconstruction service. Same token on manager and Mirror worker.
# WORLD_RECONSTRUCTION_GATEWAY_URL=http://127.0.0.1:8790
# WORLD_RECONSTRUCTION_GATEWAY_TOKEN=

# Separate customization service on an existing training host; no provisioning.
# Match this token with WORLD_CUSTOMIZATION_TOKEN on that service.
# WORLD_CUSTOMIZATION_GATEWAY_URL=http://127.0.0.1:8792
# WORLD_CUSTOMIZATION_GATEWAY_TOKEN=

# LTX 2.5 needs its own approved model profile/worker image and verified BF16 pack.
# See workers/worlds/ltx25/README.md; do not point it at an Astronex gateway.
# Worker-only settings are in docs/worlds.worker.env.example.
