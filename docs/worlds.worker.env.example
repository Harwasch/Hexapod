# Inference worker ONLY. Copy to .env.worlds-worker.local (gitignored), chmod 600.
# Match the API's gateway token; never add API or cloud account credentials here.
WORLD_GATEWAY_TOKEN=
WORLD_BIND=0.0.0.0
PORT=8789
WORLD_MODEL_ID=astronex-world
ASTRONEX_SOURCE=/opt/astronex
ASTRONEX_WEIGHTS=/models/astronex
INFERENCE_PYTHON=/opt/venv/bin/python

# Alternative model-specific settings (paths must match the prepared image).
# WORLD_MODEL_ID=forge-wm
# FORGEWM_SOURCE=/opt/upstream
# FORGEWM_WEIGHTS=/models/forge-wm
# FORGEWM_PYTHON=/opt/inference/bin/python
# WORLD_MODEL_ID=matrix-game-3
# MATRIX_GAME_SOURCE=/opt/upstream/Matrix-Game-3
# MATRIX_GAME_WEIGHTS=/models/matrix-game-3
# MATRIX_GAME_PYTHON=/opt/inference/bin/python
# WORLD_MODEL_ID=sana-wm
# SANA_WM_SOURCE=/opt/upstream
# SANA_WM_WEIGHTS=/models/sana-wm
# SANA_WM_PYTHON=/opt/inference/bin/python
# WORLD_MODEL_ID=helix-world
# HELIXWORLD_SOURCE=/opt/helixworld
# HELIXWORLD_PYTHON=/opt/helixworld-venv/bin/python
# Helix artifacts mount at /opt/helixworld/models; Python3.11 runtime required.

# LTX 2.5 uses a SEPARATE Python3.11 / Torch2.13+cu132 environment.
# WORLD_MODEL_ID=ltx-2.5
# LTX25_SOURCE=/opt/ltx25
# LTX25_WEIGHTS=/models/ltx-2.5
# LTX25_PYTHON=/opt/ltx25-venv/bin/python
# LTX25_RESIDENCY=gpu  # transformer resident; cpu uses block streaming.
# Run bootstrap.py --verify-assets once before mounting weights read-only.
# See workers/worlds/ltx25/README.md for exact source/checkpoint pins.

# Idle timeout is 60..14400 seconds. Warm pool timeout is 0..900 seconds.
WORLD_IDLE_SECONDS=300
WORLD_WARM_MODEL_SECONDS=180
# Warm reuse only on adapters that acknowledge private-state reset.
# SANA ends its process per session; Helix reloads its CLI per clip.

# software = VP8 default; h264-software = CPU H264; nvenc = GPU H264 with CPU fallback.
WORLD_VIDEO_ENCODER=software
WORLD_VIDEO_BITRATE=3000000
# NVIDIA containers need this capability for the optional hardware encoder.
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# No third-party STUN is contacted by default. A provider HTTP proxy is not TURN.
# WORLD_STUN_URLS=stun:your-stun.example:3478
# WORLD_TURN_URLS=turns:your-turn.example:5349?transport=tcp
# WORLD_TURN_SECRET=  # Shared only with TURN service, >=32 characters.
# WORLD_ICE_TRANSPORT_POLICY=relay
# Exceed API WORLD_WORKER_MAX_LIFETIME_SECONDS plus a connection margin.
WORLD_TURN_CREDENTIAL_TTL_SECONDS=3900

# Mirror and training are SEPARATE services with their own tokens/environments.
# See workers/worlds/reconstruction/README.md and CUSTOMIZATION_SERVICE.md.
# Neither service is started by this inference environment file.
