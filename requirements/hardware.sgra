[GRAMMAR]
ELEMENTS:
- TAG: REQUIREMENT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: RATIONALE
    TYPE: String
    REQUIRED: False
  - TITLE: VERIFICATION
    TYPE: SingleChoice(Analysis, Simulation, Test, Inspection)
    REQUIRED: True
  - TITLE: EVIDENCE
    TYPE: String
    REQUIRED: False
  - TITLE: BUDGET
    TYPE: String
    REQUIRED: False
  - TITLE: STATUS
    TYPE: SingleChoice(Draft, Agreed, Implemented, Verified, Waived)
    REQUIRED: True
  RELATIONS:
  - TYPE: Parent
    ROLE: Refines
  - TYPE: File
