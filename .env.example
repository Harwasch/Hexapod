# Copy to .env and fill in whatever you have. .env is gitignored.
#
# Only needed for rung 2 of the image ladder. If the Hugging Face connector's
# image Spaces are available to your account, you need none of this — see the
# hw-imagegen skill.
#
# Check what is picked up with:  imagegen --list

# START HERE. Hugging Face Inference: a free read token, no connector, no
# Space invocation, and it works from a cloud session. Get one at
# https://huggingface.co/settings/tokens
# HF_TOKEN=

# fal.ai — supports --init-image (restyles a geometry render)
# FAL_KEY=

# Black Forest Labs — supports --init-image via FLUX Kontext
# BFL_API_KEY=

# OpenAI — text-to-image only in this script
# OPENAI_API_KEY=
