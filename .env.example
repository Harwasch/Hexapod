# ─────────────────────────────────────────────────────────────────────────────
# Digital twin — environment configuration
# Copy to .env and fill in what you have. Nothing here is required to boot:
# every optional integration degrades to a labeled "unavailable" state.
#
# Variables prefixed VITE_ are PUBLIC: Vite inlines them into the browser
# bundle. Never put a server secret behind a VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (apps/web) ──────────────────────────────────────────────────────

# Cesium ion access token used by the browser. Create one at
# https://ion.cesium.com/tokens with ONLY these scopes: assets:read, geocode.
# Restrict "Allowed URLs" to your deployed origins (and http://localhost:5173).
# If empty, the app falls back to the evaluation token shipped inside CesiumJS,
# which is rate-limited and intended for development only.
VITE_CESIUM_ION_ACCESS_TOKEN=

# Your own high-resolution reality-model assets (Cesium ion asset IDs).
# Any subset may be provided; missing representations are simply not offered.
VITE_DEFAULT_SPLAT_ASSET_ID=
VITE_DEFAULT_MESH_ASSET_ID=
VITE_DEFAULT_POINTCLOUD_ASSET_ID=

# Where the site/layer catalog API lives. Leave empty to use the Vite dev proxy
# (`/api` → http://localhost:8000) during development.
VITE_API_BASE_URL=

# Where the offline catalog is published (app.seed.publish writes it beside the
# tiles). With the API unreachable the console reads this to know which captures
# exist; their tiles come from the same host, which is why an offline capture is
# reachable at all. Leave empty in a checkout with no bucket.
VITE_OFFLINE_CATALOG_URL=

# Feature flag: Google Photorealistic 3D Tiles via Cesium ion (asset 2275207).
# Requires your ion token to have that asset; see docs/CESIUM.md for licensing.
VITE_ENABLE_PHOTOREALISTIC=true

# Show the developer panel toggle in production builds (always on in dev).
VITE_ENABLE_DEV_TOOLS=false

# ── Backend (apps/api) ───────────────────────────────────────────────────────

# PostgreSQL + PostGIS. Matches infra/docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/twin
# Used only by the backend test-suite.
TEST_DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/twin_test

# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The single shared write token. Every mutating endpoint requires it as
# `Authorization: Bearer <token>`; reads are open so the world stays viewable.
# Left empty, writes are open -- which is how a fresh checkout runs, and why the API
# refuses to start with APP_ENV=production and no token set.
API_WRITE_TOKEN=

# Object storage (S3 / MinIO). Optional: used for site thumbnails.
# Matches the MinIO service in infra/docker-compose.yml.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_BUCKET=twin-assets
OBJECT_STORAGE_ACCESS_KEY=twin
OBJECT_STORAGE_SECRET_KEY=twin-secret
OBJECT_STORAGE_REGION=us-east-1
# Public base URL used to build object URLs handed to the browser.
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000/twin-assets

# Where a capture's 3D Tiles are served from, as a prefix a slug is appended to.
# Leave empty and it is derived: a capture is served from your checkout when the
# checkout has it (data/tiles/<slug>/), and from the bucket under sites/<slug>/
# otherwise. Production never reads the checkout. Set this to put a CDN in front
# of the bucket.
TILES_BASE_URL=

# Cesium ion SERVER token used by the backend to read asset metadata and
# monitor reconstruction jobs (scopes: assets:list, assets:read).
# Never expose this to the frontend.
CESIUM_ION_SERVER_TOKEN=

# Mission planning agent. When set, "New plan" drafts with Claude through the
# official SDK (model below). When empty, drafts come from a rule-based planner
# and are labelled as such. Never expose this to the frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# The job worker (apps/api/app/worker, run with `python -m app.worker`). All optional:
# the defaults are what a single-machine checkout wants.
# Where a run's workdir lives. Kept after the run, because "retry from this stage" reads
# the outputs of the stages that already succeeded out of it.
WORKER_WORKDIR=var/worker
# "stub", "local" or "cloud". Local since A8: Lane 1 (splat-ingest) is real end to end
# on a CPU. Lane 2 (photo-reconstruct) stops at `train` unless this is "cloud" and
# WORKER_CLOUD_PROVIDERS names somewhere to send it.
WORKER_RUNNER=local
# Recipes this deployment ships of its own, and modules whose @stage_impl's to register.
WORKER_RECIPE_DIR=
WORKER_IMPL_MODULES=
# The claim is a committed lease, not a held row lock (A0 #2). The supervisor pushes the
# expiry forward every WORKER_POLL_S while it runs the job; a job whose lease has lapsed
# is claimable by anyone. WORKER_POLL_S is also the worst-case latency of a cancel.
WORKER_LEASE_S=30
WORKER_POLL_S=2
WORKER_IDLE_S=2
# Attempts per stage -- crashes and reclaims included -- before the job is dead-lettered.
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_S=2
# Attempts a stage gets on top of WORKER_MAX_ATTEMPTS for having been preempted. Being
# taken off a cheap interruptible box is not the stage failing, so it does not spend the
# budget meant for one that is -- but the ceiling is still hard.
WORKER_MAX_PREEMPTIONS=4

# Where a `gpu:` stage is dispatched when WORKER_RUNNER=cloud. Preferred first, and the
# LAST ONE IS THE FALLBACK: a stage that keeps being preempted moves down the list rather
# than being retried on the cheap host until the cheap host has cost more. The last entry
# must not be interruptible, which the worker refuses at startup if it is.
#   fake        the in-repo deterministic provider; tests only
#   subprocess  a local process -- how you drive a GPU box you have a shell on
#   modal       A SKETCH THAT HAS NEVER RUN. See tools/pipeline/modal_adapter.py.
# Empty (the default) means GPU stages have nowhere to go and say so.
WORKER_CLOUD_PROVIDERS=
# Preemptions of one stage before it moves to the next provider in that list.
WORKER_PREEMPTIONS_BEFORE_FALLBACK=2
WORKER_MODAL_APP=
# How often a dispatched stage is polled, and how often the machine running it is asked
# to sync `checkpoint/` back. The second decides how much work a preemption throws away.
WORKER_CLOUD_POLL_S=5
WORKER_CHECKPOINT_EVERY_S=60
# A directory both the worker and the machine running the stage can see -- an NFS mount,
# or a workstation whose GPU is in the same box. Unset, the bytes go through the bucket.
WORKER_CLOUD_TRANSFER_DIR=

# What an hour of a GPU tier costs, where this deployment knows and the survey does not:
#   PIPELINE_GPU_RATES=modal:l4=0.80,vast:a100=0.44
# tools/pipeline/providers.py ships only the four A100 rates A0 actually measured, and a
# tier with no rate records the seconds it was billed and no cost. That is deliberate: an
# invented price in a cost column is a price that gets believed. Put yours here.
PIPELINE_GPU_RATES=

# Hostname the API binds to inside containers (see docs/DEPLOYMENT.md).
API_HOST=0.0.0.0
API_PORT=8000
