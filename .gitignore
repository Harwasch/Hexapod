# Dependencies
node_modules/
.pnpm-store/

# Build output — regenerate it, do not commit it.
dist/
build/
coverage/
*.tsbuildinfo
test-results/
playwright-report/
apps/web/.vite/

# Secrets. .env.example is committed; .env is not.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Pipeline run workdirs (apps/api/app/worker, WORKER_WORKDIR). Kept after a run so a
# retry can resume from a stage; never committed.
var/

# Hardware / simulation output (other parts of this monorepo)
sim/**/*.raw
sim/**/*.log
*.op.raw
docs/_build/
output/
*-backups/
*.kicad_prl
fp-info-cache
~*.lck
*.kicad_sch-bak
*.kicad_pcb-bak

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local scratch
/tmp/

# Downloaded sample objects (fetched by apps/web/scripts/fetch-sample-object.mjs)
apps/web/public/samples/

# The large synthetic tree (~50k splats, ~4 MB). Regenerate it, do not commit it:
#   cd tools/captures && uv run python synthetic_tree.py \
#     ../../data/tiles/synthetic-tree-large --splats 50000
data/tiles/synthetic-tree-large/
