{
  "name": "hexapod-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @twin/web dev",
    "preview": "pnpm --filter @twin/web preview",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "samples": "pnpm --filter @twin/web samples",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/web\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"./packages/**\" --filter \"./apps/web\" test",
    "e2e": "pnpm --filter @twin/web e2e",
    "contracts:generate": "pnpm --filter @twin/contracts generate",
    "contracts:check": "pnpm --filter @twin/contracts check",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "eslint-plugin-jsx-a11y": "^6.10.2"
  },
  "type": "module"
}
